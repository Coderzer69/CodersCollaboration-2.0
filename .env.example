# Backend adapter (see src/lib/collab.ts). Leave both empty to run without a server:
# rooms get a random id and edits sync between tabs of the same browser.

# Base URL of your REST API. createRoom() does POST {NEXT_PUBLIC_API_URL}/api/rooms and expects { "id": "..." }
NEXT_PUBLIC_API_URL=
# socket.io server URL. Emits "join-room" (room id) and "code-change" ({ room, files }); listens for "code-change".
NEXT_PUBLIC_SOCKET_URL=
# Canonical site URL for metadata, sitemap and robots.
NEXT_PUBLIC_SITE_URL=https://coderscollaboration.onrender.com
